@PACKAGE_INIT@

# ==================== 自包含发行包配置 ====================
# 本包不查找、不依赖任何第三方库：
#   - 静态模式：VMPUI.lib 已包含 SDL3/freetype/harfbuzz/yogacore 及资源表的全部对象；
#   - 动态模式：VMPUI.dll 已包含全部第三方实现。
# 消费者只需要：
#   find_package(VMPUI CONFIG REQUIRED)
#   target_link_libraries(app PRIVATE VMPUI::ui)
# 系统平台库（如 Windows 的 winmm/dxgi/d3d11 等）已由 VMPUITargets.cmake 以
# $<LINK_ONLY:...> 形式挂在 VMPUI::ui 上，无需消费者手动链接。

include("${CMAKE_CURRENT_LIST_DIR}/VMPUITargets.cmake")
check_required_components(VMPUI)